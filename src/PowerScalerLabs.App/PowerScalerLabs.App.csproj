<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>PowerScalerLabs</AssemblyName>
    <RootNamespace>PowerScalerLabs.App</RootNamespace>
    <ApplicationIcon>Assets\PowerScaler.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerScalerLabs.Protocol\PowerScalerLabs.Protocol.csproj" />
    <Resource Include="Assets\PowerScaler.ico" />
    <Resource Include="Assets\PowerScalerIcon.png" />
  </ItemGroup>
</Project>
