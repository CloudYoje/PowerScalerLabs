<Window x:Class="PowerScalerLabs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerScaler Labs — Native Causal Probe Foundation"
        Icon="Assets/PowerScaler.ico"
        Width="980"
        Height="660"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#091727" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/PowerScalerIcon.png" Width="34" Height="34" Stretch="Uniform" />
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PowerScaler" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="LABS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,7" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
                    <Border Style="{StaticResource CardStyle}" Padding="9">
                        <StackPanel>
                            <TextBlock Text="RESEARCH MODE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Causal tracing foundation" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Cleanup Gate · Pre-Probe" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="3,8,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="DashboardNavButton" Content="Dashboard" Tag="Selected" Style="{StaticResource NavButtonStyle}" Click="DashboardNavButton_Click" />
                        <Button x:Name="RuntimeNavButton" Content="Runtime" Style="{StaticResource NavButtonStyle}" Click="RuntimeNavButton_Click" />
                        <Button x:Name="FightersNavButton" Content="Fighters" Style="{StaticResource NavButtonStyle}" Click="FightersNavButton_Click" />
                        <Button x:Name="ResearchNavButton" Content="Research" Style="{StaticResource NavButtonStyle}" Click="ResearchNavButton_Click" />
                        <Button x:Name="FindingsNavButton" Content="Findings" Style="{StaticResource NavButtonStyle}" Click="FindingsNavButton_Click" />
                        <Button x:Name="LogsNavButton" Content="Diagnostics" Style="{StaticResource NavButtonStyle}" Click="LogsNavButton_Click" />
                        <Button x:Name="ToolsNavButton" Content="Tools" Style="{StaticResource NavButtonStyle}" Click="ToolsNavButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <TextBlock Text="RESEARCH RUNTIME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="HeaderRuntimeStateText" Text="Offline" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="20" FontWeight="Bold" />
                        <TextBlock x:Name="PageSubtitleText" Text="Live fighter state and causal-research readiness" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid x:Name="DashboardPage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,5,5">
                                    <StackPanel>
                                        <TextBlock Text="RUNTIME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardRuntimeStateText" Text="Offline" Foreground="{StaticResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DashboardRuntimePidText" Text="PID —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="5,0,0,5">
                                    <StackPanel>
                                        <TextBlock Text="DBXV2" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardGameStateText" Text="Not detected" Foreground="{StaticResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DashboardGamePidText" Text="PID —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,5,5,0">
                                    <StackPanel>
                                        <TextBlock Text="FIGHTER REGISTRY" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardFighterStateText" Text="Waiting" Foreground="{StaticResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DashboardFighterCountText" Text="0 fighters" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="5,5,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CAUSAL PROBE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardProbeStateText" Text="Starting" Foreground="{StaticResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DashboardProbeDetailText" Text="Host PID —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Current research foundation" FontSize="17" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardDetailText" Text="Waiting for the external read-only runtime." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock x:Name="DashboardCoreText" Text="BattleCore —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0" />
                                    <TextBlock x:Name="DashboardHeartbeatText" Text="Last heartbeat —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Cleanup result" FontWeight="Bold" />
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="The broad snapshot/diff scanner, guided experiment overlay, generic recording sessions, and candidate-ranking workflow are retired from the application. Chronology remains as supporting temporal evidence; targeted memory inspection remains an internal runtime primitive for later causal research." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="RuntimePage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Start" Style="{StaticResource PrimaryButtonStyle}" Click="StartRuntimeButton_Click" />
                                            <Button Content="Stop" Style="{StaticResource SecondaryButtonStyle}" Click="StopRuntimeButton_Click" />
                                            <Button Content="Reconnect" Style="{StaticResource SecondaryButtonStyle}" Click="ReconnectButton_Click" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="RuntimeStateText" Text="Offline" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock x:Name="RuntimeDetailText" Text="Runtime is not connected." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,16,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="RuntimeProcessText" Text="Runtime PID —" Margin="0,9,0,0" />
                                    <TextBlock x:Name="GameProcessText" Text="Game PID —" />
                                    <TextBlock x:Name="GameVersionText" Text="Game version —" />
                                    <TextBlock x:Name="PatcherDetailText" Text="XV2 Patcher —" />
                                    <TextBlock x:Name="BattleCoreDetailText" Text="BattleCore —" />
                                    <TextBlock x:Name="RuntimeHeartbeatText" Text="Heartbeat —" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Access architecture" FontWeight="Bold" />
                                    <TextBlock x:Name="RuntimeAccessGateText" Text="Runtime access architecture —" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock x:Name="LocatorDetailText" Text="BattleCore provider —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="ReadBudgetText" Text="Read budget —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="ComparisonPolicyText" Text="Comparison policy —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="FightersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Live fighter registry" FontSize="17" FontWeight="Bold" />
                            <TextBlock x:Name="FighterSummaryText" Text="Waiting for validated Battle_Mob objects." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="The address identifies the live object; slot generation protects against pointer reuse. Character/preset identity is intentionally unresolved until the causal identity gate." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FighterRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="55" />
                            <DataGridTextColumn Header="Generation" Binding="{Binding SlotGeneration}" Width="85" />
                            <DataGridTextColumn Header="Battle_Mob" Binding="{Binding ActorAddressText}" Width="*" />
                            <DataGridTextColumn Header="Current HP" Binding="{Binding CurrentHealth, StringFormat=G8}" Width="110" />
                            <DataGridTextColumn Header="Maximum HP" Binding="{Binding MaximumHealth, StringFormat=G8}" Width="110" />
                            <DataGridTextColumn Header="Health" Binding="{Binding HealthPercent, StringFormat=P1}" Width="75" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="ResearchPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button x:Name="AttachProbeButton" Content="Attach Probe" Style="{StaticResource PrimaryButtonStyle}" Click="AttachProbeButton_Click" IsEnabled="False" />
                                    <Button x:Name="DetachProbeButton" Content="Detach Probe" Style="{StaticResource SecondaryButtonStyle}" Click="DetachProbeButton_Click" IsEnabled="False" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Native causal probe" FontSize="17" FontWeight="Bold" />
                                    <TextBlock x:Name="ProbeStateText" Text="Starting" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock x:Name="ProbeDetailText" Text="Waiting for the isolated ProbeHost." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0" />
                                    <TextBlock x:Name="ProbeIdentityText" Text="Host PID — · Game PID — · ABI 1 · session —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="ProbeHeartbeatText" Text="No native heartbeat. Instrumentation is inactive." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="HP WRITE TRACE" FontWeight="Bold" />
                            <WrapPanel Margin="0,6,0,4">
                                <ComboBox x:Name="HpTraceFighterCombo" ItemsSource="{Binding FighterRows}" DisplayMemberPath="ActorAddressText" Width="210" SelectionChanged="HpTraceFighterCombo_SelectionChanged" />
                                <Button x:Name="ArmHpTraceButton" Content="Arm HP Write Trace" Style="{StaticResource PrimaryButtonStyle}" Click="ArmHpTraceButton_Click" IsEnabled="False" />
                                <Button x:Name="DisarmHpTraceButton" Content="Disarm" Style="{StaticResource SecondaryButtonStyle}" Click="DisarmHpTraceButton_Click" IsEnabled="False" />
                            </WrapPanel>
                            <TextBlock x:Name="HpTraceTargetText" Text="Select a live fighter generation. Target: Battle_Mob + 0x100." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="HpTraceStateText" Text="Disarmed" FontWeight="SemiBold" Margin="0,4,0,8" />
                            <TextBlock Text="SYNTHETIC TRANSPORT" FontWeight="Bold" />
                            <WrapPanel>
                                <Button Content="Test Trace Transport" Style="{StaticResource PrimaryButtonStyle}" Click="TestTraceTransportButton_Click" />
                                <Button Content="Run Sequential 25" Style="{StaticResource SecondaryButtonStyle}" Click="SequentialTraceButton_Click" />
                                <Button Content="Run Wraparound 512" Style="{StaticResource SecondaryButtonStyle}" Click="WraparoundTraceButton_Click" />
                                <Button Content="Run Overflow 10000" Style="{StaticResource SecondaryButtonStyle}" Click="OverflowTraceButton_Click" />
                                <Button Content="Export Transport Gate Report" Style="{StaticResource SecondaryButtonStyle}" Click="ExportTransportReportButton_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="TransportMetricsText" Text="requested 0 · acknowledged 0 · received 0 · missing 0 · duplicate 0 · malformed 0 · dropped 0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="TransportGateResultText" Text="LIVE TRANSPORT GATE · results are not persisted" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding ProbeTraceRows}" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" Width="85" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                            <DataGridTextColumn Header="Native QPC" Binding="{Binding Qpc}" Width="140" />
                            <DataGridTextColumn Header="Thread" Binding="{Binding NativeThread}" Width="75" />
                            <DataGridTextColumn Header="Trace session" Binding="{Binding TraceSession}" Width="*" />
                            <DataGridTextColumn Header="Watch ID" Binding="{Binding WatchId}" Width="110" />
                            <DataGridTextColumn Header="Trap / code context" Binding="{Binding TrapLocation}" Width="2*" />
                            <DataGridTextColumn Header="RCX fighter" Binding="{Binding RcxCorrelation}" Width="125" />
                            <DataGridTextColumn Header="RDX fighter" Binding="{Binding RdxCorrelation}" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="New Epoch" Style="{StaticResource SecondaryButtonStyle}" Click="NewChronologyEpochButton_Click" />
                                <Button Content="Pause" Style="{StaticResource SecondaryButtonStyle}" Click="PauseChronologyButton_Click" />
                                <Button Content="Resume" Style="{StaticResource SecondaryButtonStyle}" Click="ResumeChronologyButton_Click" />
                                <Button Content="Clear View" Style="{StaticResource SecondaryButtonStyle}" Click="ClearChronologyViewButton_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="ChronologyStatusText" Text="Chronology is waiting for the runtime." FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ChronologyMetricsText" Text="No chronology connection." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataGrid Grid.Row="4" ItemsSource="{Binding ChronologyRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="95" />
                            <DataGridTextColumn Header="Seq" Binding="{Binding Sequence}" Width="65" />
                            <DataGridTextColumn Header="Epoch" Binding="{Binding Epoch}" Width="60" />
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="50" />
                            <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="70" />
                            <DataGridTextColumn Header="Previous" Binding="{Binding Previous}" Width="95" />
                            <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="95" />
                            <DataGridTextColumn Header="Delta" Binding="{Binding Delta}" Width="95" />
                            <DataGridTextColumn Header="Stage" Binding="{Binding Validation}" Width="95" />
                            <DataGridTextColumn Header="Anchor" Binding="{Binding Label}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="FindingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Durable findings" FontSize="17" FontWeight="Bold" />
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="Only durable anchors belong here. Probabilistic candidate tiers, noise rankings, and auto-classification were removed. Future code anchors will progress through Observed → Reproduced → Code-anchored → Causally validated → Virtualization-ready." />
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FindingRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="150" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="125" />
                            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="120" />
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="140" />
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Click="ClearLogsButton_Click" />
                                <Button Content="Open Logs" Style="{StaticResource SecondaryButtonStyle}" Click="OpenLogsButton_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Runtime events" FontWeight="Bold" />
                                <TextBlock Text="Fighter lifetime and known-field events only; broad scanner observations are no longer surfaced." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding EventRows}" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="95" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="125" />
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="50" />
                            <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="160" />
                            <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="70" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="145" />
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Application log" FontWeight="Bold" Margin="0,0,0,5" />
                    <ListBox Grid.Row="3" x:Name="LogList" Background="#071522" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource PrimaryTextBrush}" />
                </Grid>

                <Grid x:Name="ToolsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="HealthScale 1.1.1 companion" FontSize="17" FontWeight="Bold" />
                                    <TextBlock x:Name="HealthScaleStateText" Text="Sealed · Separate" Margin="0,5,0,0" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HealthScaleDetailText" Text="Companion status unavailable." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="HealthScaleGameRunningText" Text="Game state —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />

                                    <TextBlock Text="DBXV2 / bin folder" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="0,10,0,3" />
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Content="Browse" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseHealthScaleGamePathButton_Click" />
                                            <Button Content="Save" Style="{StaticResource SecondaryButtonStyle}" Click="SaveHealthScaleGamePathButton_Click" />
                                        </StackPanel>
                                        <TextBox x:Name="HealthScaleGamePathTextBox" />
                                    </DockPanel>

                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="HealthScaleInstallButton" Content="Install / Adopt" Style="{StaticResource PrimaryButtonStyle}" Click="InstallHealthScaleButton_Click" />
                                        <Button x:Name="HealthScaleVerifyButton" Content="Verify" Style="{StaticResource SecondaryButtonStyle}" Click="VerifyHealthScaleButton_Click" />
                                        <Button x:Name="HealthScaleUninstallButton" Content="Uninstall" Style="{StaticResource SecondaryButtonStyle}" Click="UninstallHealthScaleButton_Click" />
                                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshHealthScaleButton_Click" />
                                        <Button Content="Open Game Bin" Style="{StaticResource SecondaryButtonStyle}" Click="OpenHealthScaleGameBinButton_Click" />
                                        <Button Content="Companion Files" Style="{StaticResource SecondaryButtonStyle}" Click="OpenHealthScaleCompanionFilesButton_Click" />
                                    </WrapPanel>

                                    <TextBlock x:Name="HealthScalePayloadText" Text="Payload: —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock x:Name="HealthScaleInstalledText" Text="Installed: —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HealthScalePayloadHashText" Text="Payload SHA-256: —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HealthScaleInstalledHashText" Text="Installed SHA-256: —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="FooterHeartbeatText" Text="Heartbeat —" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Passive Runtime: read-only · Causal Probe: explicit attach, instrumentation inactive" Foreground="{StaticResource SecondaryTextBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
