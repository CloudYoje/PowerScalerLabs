<Window x:Class="PowerScalerLabs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerScaler Labs — Runtime Access Architecture Gate 0"
        Icon="Assets/PowerScaler.ico"
        Width="880"
        Height="590"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#091727" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/PowerScalerIcon.png" Width="34" Height="34" Stretch="Uniform" />
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PowerScaler" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="LABS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,7" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
                    <Border Style="{StaticResource CardStyle}" Padding="9">
                        <StackPanel>
                            <TextBlock Text="HEALTHSCALE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="SidebarHealthScaleStateText" Text="Sealed · Separate" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Access Gate 0 · Companion 1" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Margin="3,8,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="DashboardNavButton" Content="Dashboard" Tag="Selected" Style="{StaticResource NavButtonStyle}" Click="DashboardNavButton_Click" />
                        <Button x:Name="RuntimeNavButton" Content="Runtime Connection" Style="{StaticResource NavButtonStyle}" Click="RuntimeNavButton_Click" />
                        <Button x:Name="FightersNavButton" Content="Live Fighters" Style="{StaticResource NavButtonStyle}" Click="FightersNavButton_Click" />
                        <Button x:Name="ScannerNavButton" Content="Capability Scanner" Style="{StaticResource NavButtonStyle}" Click="ScannerNavButton_Click" />
                        <Button x:Name="RecordingNavButton" Content="Recording" Style="{StaticResource NavButtonStyle}" Click="RecordingNavButton_Click" />
                        <Button x:Name="CandidatesNavButton" Content="Candidates &amp; Findings" Style="{StaticResource NavButtonStyle}" Click="CandidatesNavButton_Click" />
                        <Button x:Name="CompanionAppsNavButton" Content="Companion Apps" Style="{StaticResource NavButtonStyle}" Click="CompanionAppsNavButton_Click" />
                        <Button x:Name="LogsNavButton" Content="Diagnostics" Style="{StaticResource NavButtonStyle}" Click="LogsNavButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <TextBlock Text="COMPANION RUNTIME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="HeaderRuntimeStateText" Text="Offline" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="20" FontWeight="Bold" />
                        <TextBlock x:Name="PageSubtitleText" Text="Full external character-state discovery and durable evidence" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid x:Name="DashboardPage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,5,5">
                                    <StackPanel>
                                        <TextBlock Text="RUNTIME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardRuntimeStateText" Text="Offline" Foreground="{StaticResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DashboardRuntimePidText" Text="PID —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="5,0,0,5">
                                    <StackPanel>
                                        <TextBlock Text="DBXV2" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardGameStateText" Text="Not detected" Foreground="{StaticResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DashboardGamePidText" Text="PID —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,5,5,0">
                                    <StackPanel>
                                        <TextBlock Text="FIGHTERS" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardObserverStateText" Text="Not active" Foreground="{StaticResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DashboardFighterCountText" Text="0 fighters" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="5,5,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SCANNER" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardScannerStateText" Text="No baseline" Foreground="{StaticResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DashboardScannerMetricsText" Text="0 observations" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Chronological Telemetry" FontSize="17" FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardDetailText" Text="Waiting for the separate read-only runtime." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,16,0" />
                                        <TextBlock x:Name="DashboardCoreText" Text="BattleCore —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DashboardHeartbeatText" Text="Last heartbeat —" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Open Test Overlay" Style="{StaticResource PrimaryButtonStyle}" Click="OpenGuidedOverlayButton_Click" />
                                        <Button Content="Start Runtime" Style="{StaticResource SecondaryButtonStyle}" Click="StartRuntimeButton_Click" />
                                        <Button Content="Stop" Style="{StaticResource SecondaryButtonStyle}" Click="StopRuntimeButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Recording" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardRecordingStateText" Text="Stopped" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0" />
                                    <TextBlock x:Name="DashboardRecordingCountText" Text="0 frames · 0 events · 0 scan observations" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="RuntimePage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="RuntimeStateText" Text="Offline" FontSize="18" FontWeight="Bold" />
                                    <TextBlock x:Name="RuntimeDetailText" Text="Companion runtime is not connected." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Start Runtime" Style="{StaticResource PrimaryButtonStyle}" Click="StartRuntimeButton_Click" />
                                        <Button Content="Stop Runtime" Style="{StaticResource SecondaryButtonStyle}" Click="StopRuntimeButton_Click" />
                                        <Button Content="Reconnect Pipe" Style="{StaticResource SecondaryButtonStyle}" Click="ReconnectButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="RuntimeProcessText" Text="Runtime PID —" />
                                    <TextBlock x:Name="GameProcessText" Text="Game PID —" Margin="0,6,0,0" />
                                    <TextBlock x:Name="GameVersionText" Text="Game version —" Margin="0,6,0,0" />
                                    <TextBlock x:Name="PatcherDetailText" Text="XV2 Patcher —" Margin="0,6,0,0" />
                                    <TextBlock x:Name="BattleCoreDetailText" Text="BattleCore —" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RuntimeAccessGateText" Text="Runtime access architecture —" Margin="0,12,0,0" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LocatorDetailText" Text="BattleCore provider —" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ReadBudgetText" Text="Read budget —" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ComparisonPolicyText" Text="Comparison policy —" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RuntimeHeartbeatText" Text="Heartbeat —" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="FightersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FighterSummaryText" Text="Waiting for validated Battle_Mob objects." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FighterRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="55" />
                            <DataGridTextColumn Header="Actor" Binding="{Binding ActorAddressText}" Width="*" />
                            <DataGridTextColumn Header="Generation" Binding="{Binding SlotGeneration}" Width="85" />
                            <DataGridTextColumn Header="Current HP" Binding="{Binding CurrentHealth, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="Maximum HP" Binding="{Binding MaximumHealth, StringFormat=N2}" Width="105" />
                            <DataGridTextColumn Header="Health" Binding="{Binding HealthPercent, StringFormat=P1}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="ScannerPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Scan configuration" FontWeight="Bold" />
                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Width="95" Margin="0,0,8,6">
                                    <TextBlock Text="Start offset" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBox x:Name="ScanStartOffsetTextBox" Text="0x000" />
                                </StackPanel>
                                <StackPanel Width="95" Margin="0,0,8,6">
                                    <TextBlock Text="End offset" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBox x:Name="ScanEndOffsetTextBox" Text="0x1000" />
                                </StackPanel>
                                <StackPanel Width="70" Margin="0,0,8,6">
                                    <TextBlock Text="Stride" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBox x:Name="ScanStrideTextBox" Text="4" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,8,6">
                                    <TextBlock Text="Fighters" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBox x:Name="ScanMaximumFightersTextBox" Text="2" />
                                </StackPanel>
                                <StackPanel Width="85" Margin="0,0,8,6">
                                    <TextBlock Text="Poll ms" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBox x:Name="ScanIntervalTextBox" Text="250" />
                                </StackPanel>
                                <StackPanel Width="95" Margin="0,0,8,6">
                                    <TextBlock Text="Batch size" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBox x:Name="ScanObservationLimitTextBox" Text="400" />
                                </StackPanel>
                                <StackPanel Width="95" Margin="0,0,8,6">
                                    <TextBlock Text="Child bytes" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBox x:Name="ChildScanSizeTextBox" Text="0x200" />
                                </StackPanel>
                                <StackPanel Width="75" Margin="0,0,8,6">
                                    <TextBlock Text="Ptr depth" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBox x:Name="PointerDepthTextBox" Text="1" />
                                </StackPanel>
                                <StackPanel Width="85" Margin="0,0,8,6">
                                    <TextBlock Text="Child objects" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBox x:Name="MaxChildObjectsTextBox" Text="4" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,2,0,0">
                                <CheckBox x:Name="ScanFloat32CheckBox" Content="Float32" IsChecked="True" Margin="0,0,10,5" />
                                <CheckBox x:Name="ScanInt32CheckBox" Content="Int32" IsChecked="True" Margin="0,0,10,5" />
                                <CheckBox x:Name="ScanUInt32CheckBox" Content="UInt32" IsChecked="True" Margin="0,0,10,5" />
                                <CheckBox x:Name="ScanFloat64CheckBox" Content="Float64" Margin="0,0,10,5" />
                                <CheckBox x:Name="ScanInt64CheckBox" Content="Int64" Margin="0,0,10,5" />
                                <CheckBox x:Name="ScanUInt64CheckBox" Content="UInt64" Margin="0,0,10,5" />
                                <CheckBox x:Name="ScanInt16CheckBox" Content="Int16" Margin="0,0,10,5" />
                                <CheckBox x:Name="ScanUInt16CheckBox" Content="UInt16" Margin="0,0,10,5" />
                                <CheckBox x:Name="ScanByteCheckBox" Content="Byte" Margin="0,0,10,5" />
                                <CheckBox x:Name="ScanPointer64CheckBox" Content="Pointer64" IsChecked="True" Margin="0,0,10,5" />
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="ContinuousTrackingCheckBox" Content="Continuous change tracking" IsChecked="True" Margin="0,0,16,5" />
                                <CheckBox x:Name="FollowPointersCheckBox" Content="Follow object pointers (bounded depth)" IsChecked="True" Margin="0,0,16,5" />
                                <Button Content="Apply Configuration" Style="{StaticResource SecondaryButtonStyle}" Click="ApplyScannerConfigButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="ScannerStatusText" Text="Capture a baseline to begin." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ScannerMetricsText" Text="No baseline · 0 queued observations" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <DockPanel Margin="0,8,0,0">
                                <ComboBox x:Name="ActionLabelComboBox" IsEditable="True" MinWidth="240" Margin="0,0,8,6" Text="Idle baseline">
                                    <ComboBoxItem Content="Idle baseline" />
                                    <ComboBoxItem Content="Spend Ki" />
                                    <ComboBoxItem Content="Regenerate Ki" />
                                    <ComboBoxItem Content="Gain Ki from attacks" />
                                    <ComboBoxItem Content="Spend stamina" />
                                    <ComboBoxItem Content="Regenerate stamina" />
                                    <ComboBoxItem Content="Take damage" />
                                    <ComboBoxItem Content="Heal / recover health" />
                                    <ComboBoxItem Content="KO / revive" />
                                    <ComboBoxItem Content="Deal basic attack damage" />
                                    <ComboBoxItem Content="Use basic Ki blast" />
                                    <ComboBoxItem Content="Use strike skill" />
                                    <ComboBoxItem Content="Use Ki blast skill" />
                                    <ComboBoxItem Content="Use evasive skill" />
                                    <ComboBoxItem Content="Transform" />
                                    <ComboBoxItem Content="De-transform" />
                                    <ComboBoxItem Content="Apply buff / effect" />
                                    <ComboBoxItem Content="Remove buff / effect" />
                                    <ComboBoxItem Content="Receive debuff" />
                                    <ComboBoxItem Content="Guard" />
                                    <ComboBoxItem Content="Perfect guard" />
                                    <ComboBoxItem Content="Stamina break" />
                                    <ComboBoxItem Content="Z-vanish" />
                                    <ComboBoxItem Content="Step / dash" />
                                    <ComboBoxItem Content="Movement / flight" />
                                    <ComboBoxItem Content="Lock-on target change" />
                                    <ComboBoxItem Content="Skill cooldown start / end" />
                                </ComboBox>
                                <WrapPanel>
                                    <Button Content="Open Guided Overlay" Style="{StaticResource PrimaryButtonStyle}" Click="OpenGuidedOverlayButton_Click" />
                                <Button Content="Capture Baseline" Style="{StaticResource PrimaryButtonStyle}" Click="CaptureBaselineButton_Click" />
                                    <Button Content="Compare After Action" Style="{StaticResource PrimaryButtonStyle}" Click="CompareAfterButton_Click" />
                                    <Button Content="Full Snapshot" Style="{StaticResource SecondaryButtonStyle}" Click="FullSnapshotButton_Click" />
                                    <Button Content="Clear Baseline" Style="{StaticResource SecondaryButtonStyle}" Click="ClearBaselineButton_Click" />
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="ScannerObservationGrid" ItemsSource="{Binding ScannerObservationRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="70" />
                            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="85" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="140" />
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="45" />
                            <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="150" />
                            <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="70" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="75" />
                            <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="95" />
                            <DataGridTextColumn Header="Delta" Binding="{Binding Delta}" Width="90" />
                            <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="RecordingPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="RecordingStatusText" Text="No active recording." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="RecordingMetricsText" Text="0 frames · 0 events · 0 scan observations · 0 chronology samples" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                            <TextBlock x:Name="ChronologyStatusText" Text="Chronology sampler waiting for the runtime." FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="ChronologyMetricsText" Text="6 focused targets · 25 ms · 0 samples · 0 dropped" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Session name" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,3" />
                            <TextBox x:Name="SessionNameTextBox" Text="Character Capability Scan" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Start Recording" Style="{StaticResource PrimaryButtonStyle}" Click="StartRecordingButton_Click" />
                                <Button Content="Stop &amp; Save" Style="{StaticResource SecondaryButtonStyle}" Click="StopRecordingButton_Click" />
                                <Button Content="Open Sessions" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSessionsButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TabControl Grid.Row="1">
                        <TabItem Header="Chronological changes">
                            <DataGrid ItemsSource="{Binding ChronologyRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="95" />
                                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="55" />
                                    <DataGridTextColumn Header="Poll" Binding="{Binding Capture}" Width="55" />
                                    <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="45" />
                                    <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="70" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                                    <DataGridTextColumn Header="Previous" Binding="{Binding Previous}" Width="85" />
                                    <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="85" />
                                    <DataGridTextColumn Header="Delta" Binding="{Binding Delta}" Width="85" />
                                    <DataGridTextColumn Header="Validation" Binding="{Binding Validation}" Width="95" />
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Semantic events">
                            <DataGrid ItemsSource="{Binding EventRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="75" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="145" />
                                    <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="45" />
                                    <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="145" />
                                    <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="70" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" />
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Grid x:Name="CandidatesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="CandidateSummaryText" Text="No retained candidates." TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <TextBox x:Name="CandidateFilterTextBox" Width="170" Margin="0,0,8,6"
                                         ToolTip="Filter by family, role, offset, type, region, label, status, tag, or action"
                                         TextChanged="CandidateFilterTextBox_TextChanged" />
                                <ComboBox x:Name="CandidateFamilyFilterComboBox" Width="145" Margin="0,0,8,6"
                                          SelectionChanged="CandidateClassificationFilter_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="All stat families" />
                                    <ComboBoxItem Content="Health" />
                                    <ComboBoxItem Content="Ki" />
                                    <ComboBoxItem Content="Stamina" />
                                    <ComboBoxItem Content="Basic Attack" />
                                    <ComboBoxItem Content="Strike Skills" />
                                    <ComboBoxItem Content="Ki Blast Skills" />
                                    <ComboBoxItem Content="Defense / Guard" />
                                    <ComboBoxItem Content="Transformation" />
                                    <ComboBoxItem Content="Movement" />
                                    <ComboBoxItem Content="State / Flags" />
                                    <ComboBoxItem Content="Timers / Cooldowns" />
                                    <ComboBoxItem Content="Object / Pointers" />
                                    <ComboBoxItem Content="Identity / Metadata" />
                                    <ComboBoxItem Content="Unknown" />
                                </ComboBox>
                                <ComboBox x:Name="CandidateRoleFilterComboBox" Width="145" Margin="0,0,8,6"
                                          SelectionChanged="CandidateClassificationFilter_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="All roles" />
                                    <ComboBoxItem Content="Current Value" />
                                    <ComboBoxItem Content="Maximum / Capacity" />
                                    <ComboBoxItem Content="Cost / Consumption" />
                                    <ComboBoxItem Content="Regeneration / Recovery" />
                                    <ComboBoxItem Content="Damage / Output" />
                                    <ComboBoxItem Content="Multiplier / Scaling" />
                                    <ComboBoxItem Content="Resistance / Reduction" />
                                    <ComboBoxItem Content="State / Flag" />
                                    <ComboBoxItem Content="Timer / Cooldown" />
                                    <ComboBoxItem Content="Pointer / Reference" />
                                    <ComboBoxItem Content="Identity / Metadata" />
                                    <ComboBoxItem Content="Unclassified" />
                                </ComboBox>
                                <ComboBox x:Name="CandidateTierFilterComboBox" Width="135" Margin="0,0,8,6"
                                          SelectionChanged="CandidateClassificationFilter_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Research view" />
                                    <ComboBoxItem Content="All signal tiers" />
                                    <ComboBoxItem Content="Known effect" />
                                    <ComboBoxItem Content="High-confidence" />
                                    <ComboBoxItem Content="Promising" />
                                    <ComboBoxItem Content="Needs another trial" />
                                    <ComboBoxItem Content="Background noise" />
                                </ComboBox>
                                <ComboBox x:Name="CandidateValidationFilterComboBox" Width="145" Margin="0,0,8,6"
                                          SelectionChanged="CandidateClassificationFilter_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="All validation stages" />
                                    <ComboBoxItem Content="Observed" />
                                    <ComboBoxItem Content="Correlated" />
                                    <ComboBoxItem Content="Code-anchored" />
                                    <ComboBoxItem Content="Causally validated" />
                                    <ComboBoxItem Content="Verified" />
                                </ComboBox>
                                <ComboBox x:Name="CandidateStatusFilterComboBox" Width="115" Margin="0,0,8,6"
                                          SelectionChanged="CandidateClassificationFilter_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="All statuses" />
                                    <ComboBoxItem Content="Known" />
                                    <ComboBoxItem Content="Solid" />
                                    <ComboBoxItem Content="Strong" />
                                    <ComboBoxItem Content="Candidate" />
                                    <ComboBoxItem Content="Provisional" />
                                    <ComboBoxItem Content="Noise" />
                                </ComboBox>
                                <Button Content="Open Data" Style="{StaticResource SecondaryButtonStyle}" Click="OpenCandidatesButton_Click" />
                                <Button Content="Open Findings" Style="{StaticResource SecondaryButtonStyle}" Click="OpenFindingsButton_Click" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2,0,0">
                                <TextBox x:Name="CandidateLabelTextBox" Width="150" Margin="0,0,8,6"
                                         ToolTip="Assign an exact meaning such as Current Ki" />
                                <Button Content="Assign Label" Style="{StaticResource SecondaryButtonStyle}" Click="AssignCandidateLabelButton_Click" />
                                <ComboBox x:Name="CandidateFamilyAssignComboBox" Width="135" Margin="4,0,8,6" SelectedIndex="13">
                                    <ComboBoxItem Content="Health" />
                                    <ComboBoxItem Content="Ki" />
                                    <ComboBoxItem Content="Stamina" />
                                    <ComboBoxItem Content="Basic Attack" />
                                    <ComboBoxItem Content="Strike Skills" />
                                    <ComboBoxItem Content="Ki Blast Skills" />
                                    <ComboBoxItem Content="Defense / Guard" />
                                    <ComboBoxItem Content="Transformation" />
                                    <ComboBoxItem Content="Movement" />
                                    <ComboBoxItem Content="State / Flags" />
                                    <ComboBoxItem Content="Timers / Cooldowns" />
                                    <ComboBoxItem Content="Object / Pointers" />
                                    <ComboBoxItem Content="Identity / Metadata" />
                                    <ComboBoxItem Content="Unknown" />
                                </ComboBox>
                                <ComboBox x:Name="CandidateRoleAssignComboBox" Width="145" Margin="0,0,8,6" SelectedIndex="11">
                                    <ComboBoxItem Content="Current Value" />
                                    <ComboBoxItem Content="Maximum / Capacity" />
                                    <ComboBoxItem Content="Cost / Consumption" />
                                    <ComboBoxItem Content="Regeneration / Recovery" />
                                    <ComboBoxItem Content="Damage / Output" />
                                    <ComboBoxItem Content="Multiplier / Scaling" />
                                    <ComboBoxItem Content="Resistance / Reduction" />
                                    <ComboBoxItem Content="State / Flag" />
                                    <ComboBoxItem Content="Timer / Cooldown" />
                                    <ComboBoxItem Content="Pointer / Reference" />
                                    <ComboBoxItem Content="Identity / Metadata" />
                                    <ComboBoxItem Content="Unclassified" />
                                </ComboBox>
                                <Button Content="Assign Class" Style="{StaticResource SecondaryButtonStyle}" Click="AssignCandidateClassificationButton_Click" />
                                <Button Content="Auto Classify" Style="{StaticResource SecondaryButtonStyle}" Click="AutoClassifyCandidateButton_Click" />
                                <Button Content="Promote Correlated" Style="{StaticResource PrimaryButtonStyle}" Click="PromoteCandidateButton_Click" />
                                <Button Content="Mark Noise" Style="{StaticResource SecondaryButtonStyle}" Click="RejectCandidateButton_Click" />
                            </WrapPanel>
                            <TextBlock Text="Research view shows Known effects and High-confidence correlated offsets only. Choose Promising to inspect broader hypotheses. Each row is one physical offset; alternative typed views remain preserved in raw evidence."
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="CandidateGrid" ItemsSource="{Binding CandidateRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Signal" Binding="{Binding SignalTier}" Width="110" />
                            <DataGridTextColumn Header="Validation" Binding="{Binding ValidationStage}" Width="120" />
                            <DataGridTextColumn Header="Stat family" Binding="{Binding StatFamily}" Width="115" />
                            <DataGridTextColumn Header="Role" Binding="{Binding StatRole}" Width="120" />
                            <DataGridTextColumn Header="Region" Binding="{Binding RegionPath}" Width="140" />
                            <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" Width="65" />
                            <DataGridTextColumn Header="Preferred type" Binding="{Binding PreferredValueType}" Width="90" />
                            <DataGridTextColumn Header="Other types" Binding="{Binding AlternativeTypesText}" Width="150" />
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="135" />
                            <DataGridTextColumn Header="Pair" Binding="{Binding PairRelationship}" Width="190" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75" />
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassificationConfidenceText}" Width="55" />
                            <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceCount}" Width="62" />
                            <DataGridTextColumn Header="Changes" Binding="{Binding ChangeCount}" Width="62" />
                            <DataGridTextColumn Header="Stable" Binding="{Binding StableCount}" Width="55" />
                            <DataGridTextColumn Header="Actors" Binding="{Binding DistinctActorCount}" Width="52" />
                            <DataGridTextColumn Header="Slots" Binding="{Binding DistinctSlotCount}" Width="48" />
                            <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="58" />
                            <DataGridTextColumn Header="Top actions" Binding="{Binding TopActions}" Width="180" />
                            <DataGridTextColumn Header="Evidence tags" Binding="{Binding ClassificationTagsText}" Width="220" />
                            <DataGridTextColumn Header="Last" Binding="{Binding LastValue, StringFormat=G8}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>


                <Grid x:Name="CompanionAppsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="HealthScale 1.1.1" FontSize="18" FontWeight="Bold" />
                                        <TextBlock Text="Sealed health-only companion · independently built and removable" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,12,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="HealthScaleStateText" Text="Checking companion…" Foreground="{StaticResource WarningBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0" />
                                        <TextBlock x:Name="HealthScaleDetailText" Text="No status yet." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,12,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="DBXV2 PROCESS" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="HealthScaleGameRunningText" Text="Not running" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DBXV2 installation" FontWeight="Bold" />
                                    <TextBlock Text="Select either the DB Xenoverse 2 folder or its bin folder. A valid location must contain DBXV2.exe." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <TextBox x:Name="HealthScaleGamePathTextBox" MinWidth="380" HorizontalScrollBarVisibility="Auto" />
                                    <WrapPanel Margin="0,9,0,0">
                                        <Button Content="Browse" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseHealthScaleGamePathButton_Click" />
                                        <Button Content="Save Location" Style="{StaticResource SecondaryButtonStyle}" Click="SaveHealthScaleGamePathButton_Click" />
                                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshHealthScaleButton_Click" />
                                        <Button Content="Open Game Bin" Style="{StaticResource SecondaryButtonStyle}" Click="OpenHealthScaleGameBinButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Managed payload" FontWeight="Bold" />
                                    <TextBlock x:Name="HealthScalePayloadText" Text="Payload —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock x:Name="HealthScaleInstalledText" Text="Installed —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="HealthScalePayloadHashText" Text="Payload SHA-256 —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="HealthScaleInstalledHashText" Text="Installed SHA-256 —" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="HealthScaleInstallButton" Content="Install / Adopt" Style="{StaticResource PrimaryButtonStyle}" Click="InstallHealthScaleButton_Click" />
                                        <Button x:Name="HealthScaleVerifyButton" Content="Verify" Style="{StaticResource SecondaryButtonStyle}" Click="VerifyHealthScaleButton_Click" />
                                        <Button x:Name="HealthScaleUninstallButton" Content="Uninstall Managed Copy" Style="{StaticResource SecondaryButtonStyle}" Click="UninstallHealthScaleButton_Click" />
                                        <Button Content="Open Companion Files" Style="{StaticResource SecondaryButtonStyle}" Click="OpenHealthScaleCompanionFilesButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Boundary guarantees" FontWeight="Bold" />
                                    <TextBlock Text="• PowerScaler Labs never overwrites an unknown xinput_other.dll.&#10;• DBXV2 must be closed before install or uninstall.&#10;• HealthScale is built from its own frozen Visual C++ solution.&#10;• Uninstall removes only the DLL recorded by the managed SHA-256 receipt.&#10;• A modified HealthScale.ini is preserved." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <WrapPanel>
                            <Button Content="Open Logs" Style="{StaticResource SecondaryButtonStyle}" Click="OpenLogsButton_Click" />
                            <Button Content="Clear View" Style="{StaticResource SecondaryButtonStyle}" Click="ClearLogsButton_Click" />
                        </WrapPanel>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="LogList" Background="#071522" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource BorderBrush}" />
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                <DockPanel>
                    <TextBlock Text="PowerScaler Labs · Runtime Access Architecture Gate 0 · External read-only runtime · Sealed HealthScale companion" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="FooterHeartbeatText" DockPanel.Dock="Right" Text="Heartbeat —" Foreground="{StaticResource SecondaryTextBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
