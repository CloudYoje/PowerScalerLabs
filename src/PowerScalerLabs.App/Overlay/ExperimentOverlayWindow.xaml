<Window x:Class="PowerScalerLabs.App.Overlay.ExperimentOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerScaler Labs — Guided Test Overlay"
        Width="620"
        Height="520"
        MinWidth="440"
        MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="OverlayListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#17324B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayStatusLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Border Background="#F207111F"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F20D1B2D" CornerRadius="11,11,0,0" Padding="13,9"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" Width="34" Height="27" Margin="0,0,5,0" Style="{StaticResource SecondaryButtonStyle}" Click="MinimizeOverlayButton_Click" />
                        <Button Content="×" Width="34" Height="27" Margin="0" Style="{StaticResource SecondaryButtonStyle}" Click="HideOverlayButton_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/PowerScalerLabs;component/Assets/PowerScalerIcon.png" Width="27" Height="27" Margin="0,0,9,0" />
                        <StackPanel>
                            <TextBlock Text="PowerScaler Labs" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="GUIDED IN-GAME TEST MENU" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Margin="10,9,10,7" Style="{StaticResource CardStyle}" Padding="9">
                <UniformGrid Columns="7">
                    <StackPanel Margin="4,0">
                        <TextBlock Text="RUNTIME" Style="{StaticResource OverlayStatusLabelStyle}" />
                        <TextBlock x:Name="RuntimeStateText" Text="Offline" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <TextBlock Text="FIGHTERS" Style="{StaticResource OverlayStatusLabelStyle}" />
                        <TextBlock x:Name="FighterCountText" Text="0" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <TextBlock Text="RECORDING" Style="{StaticResource OverlayStatusLabelStyle}" />
                        <TextBlock x:Name="RecordingStateText" Text="OFF" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <TextBlock Text="BASELINE" Style="{StaticResource OverlayStatusLabelStyle}" />
                        <TextBlock x:Name="BaselineStateText" Text="None" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <TextBlock Text="CHANGED" Style="{StaticResource OverlayStatusLabelStyle}" />
                        <TextBlock x:Name="ChangedCountText" Text="0" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <TextBlock Text="STABLE" Style="{StaticResource OverlayStatusLabelStyle}" />
                        <TextBlock x:Name="StableCountText" Text="0" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <TextBlock Text="PENDING" Style="{StaticResource OverlayStatusLabelStyle}" />
                        <TextBlock x:Name="PendingCountText" Text="0" FontWeight="SemiBold" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <Grid Grid.Row="2" Margin="10,0,10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="7" Margin="0,0,7,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="4,2,4,7" />
                        <ListBox x:Name="CategoryListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource OverlayListItemStyle}"
                                 SelectionChanged="CategoryListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="7" Margin="0,0,7,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="TESTS" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="4,2,4,7" />
                        <ListBox x:Name="TestListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource OverlayListItemStyle}"
                                 SelectionChanged="TestListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="11">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="SELECTED TEST" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" />
                            <TextBlock x:Name="SelectedTestNameText" Text="Idle / Stable" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,7" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedTestInstructionText" Text="Stand completely still." TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedTestExpectedText" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <TextBlock x:Name="SelectedTestTipText" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,9" />

                            <Border Background="#071522" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="1  Capture Baseline" FontWeight="SemiBold" />
                                    <TextBlock Text="2  Perform only the selected action in Xenoverse" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="3  Compare Results" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Button x:Name="CaptureBaselineButton" Content="Capture Baseline" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,6" Click="CaptureBaselineButton_Click" />
                            <Button x:Name="CompareResultsButton" Content="Compare Results" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,6" Click="CompareResultsButton_Click" />
                            <WrapPanel>
                                <Button x:Name="RepeatTestButton" Content="Repeat Test" Style="{StaticResource SecondaryButtonStyle}" Click="RepeatTestButton_Click" />
                                <Button x:Name="FullSnapshotButton" Content="Full Snapshot" Style="{StaticResource SecondaryButtonStyle}" Click="FullSnapshotButton_Click" />
                                <Button x:Name="CancelTestButton" Content="Cancel Test" Style="{StaticResource SecondaryButtonStyle}" Click="CancelTestButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="3" Margin="10,0,10,7" Style="{StaticResource CardStyle}" Padding="9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RecordingButton" Content="Start Recording" Style="{StaticResource PrimaryButtonStyle}" Click="RecordingButton_Click" />
                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FeedbackText" Text="Select a test with the mouse or arrow keys." FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailText" Text="No active experiment." Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open Main App" Style="{StaticResource SecondaryButtonStyle}" Click="OpenMainAppButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="#E80D1B2D" CornerRadius="0,0,11,11" Padding="11,7">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="F11 hide/show" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="12,0,0,0" />
                    <TextBlock Text="Mouse: click any test | Up/Down select | Left/Right switch panel | Enter confirm | Esc/Backspace go back or cancel" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
